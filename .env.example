DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pchilkaapp
DB_USER=pchilka_user
DB_PASSWORD=replace_with_strong_password

UPLOADS_DIR=/home/your_user/data/pchilka/uploads
UPLOADS_PUBLIC_BASE_URL=/media

# Optional binary paths for server-side video optimization (included in Docker).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret
# Optional separate encryption key for secrets saved via Admin → Integrations.
INTEGRATIONS_ENCRYPTION_KEY=replace_with_long_random_secret
ADMIN_BOOTSTRAP_TOKEN=replace_with_one_time_bootstrap_token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# POS archive ingest on the application server.
POS_ARCHIVE_INGEST_SECRET=replace_with_long_random_secret

# Run the exporter from a computer that can reach the private PostgreSQL server.
MARKETING_SOURCE_DB_HOST=192.168.100.200
MARKETING_SOURCE_DB_PORT=5432
MARKETING_SOURCE_DB_NAME=dbmain
MARKETING_SOURCE_DB_USER=marketing
MARKETING_SOURCE_DB_PASSWORD=replace_with_source_password
POS_ARCHIVE_API_URL=https://your-domain.example/api/analytics/pos-archive/ingest

# AI recommendations for the admin RFM dashboard. Keep this server-only key out of git.
OPENAI_API_KEY=
RFM_AI_MODEL=gpt-5.6-luna
# Engineering Help Desk: the admin panel writes credentials to this private runtime .env file.
# Default outside Docker: <project>/.env. Keep this directory persistent when deploying.
# ENGINEERING_ENV_FILE=/app/data/engineering/.env
