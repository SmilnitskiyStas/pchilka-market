APP_PORT=3000

DB_NAME=pchilkaapp
DB_USER=pchilka_user
DB_PASSWORD=replace_with_strong_password
DB_ROOT_PASSWORD=replace_with_strong_root_password

UPLOADS_PUBLIC_BASE_URL=/media

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret
# Optional separate encryption key for secrets saved via Admin → Integrations.
INTEGRATIONS_ENCRYPTION_KEY=replace_with_long_random_secret
ADMIN_BOOTSTRAP_TOKEN=replace_with_one_time_bootstrap_token

SITE_URL=https://pchilka-market.ua
NEXT_PUBLIC_SITE_URL=https://pchilka-market.ua

INVENTORY_NOTIFY_SECRET=replace_with_inventory_secret
INVENTORY_WEBHOOK_SECRET=replace_with_inventory_webhook_secret
INVENTORY_NOTIFICATIONS_AUTO_RUN=1

POS_ARCHIVE_INGEST_SECRET=replace_with_long_random_secret

# Rule 843 / MEGOGO POS integration. Keep this value server-side and out of git.
MEGOGO_POS_API_SECRET=replace_with_long_random_secret
# Temporary allow-list for the first end-to-end check. Remove before the production campaign.
MEGOGO_TEST_LOYALTY_CODE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# AI recommendations for the admin RFM dashboard. Keep this server-only key out of git.
OPENAI_API_KEY=
RFM_AI_MODEL=gpt-5.6-luna
